    "# Age has nulls — fill with median (median better than mean for age, less affected by outliers)\n",
    "df['Age'].fillna(df['Age'].median(), inplace=True)\n",
    "\n",
    "# Cabin has too many nulls (~77%) — drop it\n",
    "df.drop(columns=['Cabin'], inplace=True)\n",
    "\n",
    "# Embarked has 2 nulls — fill with mode\n",
    "df['Embarked'].fillna(df['Embarked'].mode()[0], inplace=True)\n",
    "\n",
    "# Drop columns irrelevant to survival\n",
    "df.drop(columns=['PassengerId', 'Name', 'Ticket'], inplace=True)\n",
    "\n",
    "print(\"Nulls after cleaning:\\n\", df.isnull().sum())\n",
    "print(\"\\nShape:\", df.shape)"
